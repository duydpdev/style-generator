{
  "name": "@duydpdev/style-generator",
  "version": "3.1.0-DEV.2",
  "type": "module",
  "workspaces": [
    "site",
    "examples/*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "style-gen": "dist/cli/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./cva": {
      "types": "./dist/cva.d.ts",
      "import": "./dist/cva.js",
      "require": "./dist/cva.cjs"
    },
    "./spacing": {
      "types": "./dist/spacing.d.ts",
      "import": "./dist/spacing.js",
      "require": "./dist/spacing.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "build:cli": "tsdown src/cli/index.ts --format esm --out-dir dist/cli --banner.js '#!/usr/bin/env node'",
    "build:all": "yarn build && yarn build:cli",
    "check:browser-safe": "node scripts/check-browser-safe.mjs",
    "check:externals": "node scripts/check-externals.mjs",
    "check:publish-target": "node scripts/check-publish-target.mjs",
    "check:sizes": "node scripts/check-sizes.mjs",
    "commitlint": "commitlint",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0 --no-warn-ignored",
    "lint-staged": "lint-staged",
    "lint:fix": "yarn run lint --fix",
    "prettier": "prettier .",
    "prettier:fix": "prettier --write .",
    "prepare": "husky",
    "prepublishOnly": "yarn check:publish-target && yarn check:externals && yarn check:sizes && yarn check:browser-safe",
    "release": "semantic-release",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest typecheck --run src/**/*.test-d.ts",
    "test:e2e": "playwright test",
    "site:dev": "yarn workspace site dev",
    "site:build": "yarn build:all && yarn workspace site build",
    "site:preview": "yarn workspace site preview",
    "site:deploy:manual": "yarn site:build && npx gh-pages -d site/dist"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.4.3",
    "@commitlint/types": "^20.4.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@tailwindcss/node": "^4.2.4",
    "@types/node": "^25.3.3",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "class-variance-authority": "^0.7.0",
    "commitlint": "^20.4.3",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sonarjs": "^4.0.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.3",
    "tailwindcss": "^4.2.1",
    "tsdown": "^0.21.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.1.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duydpdev/style-generator.git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix --no-warn-ignored --max-warnings 0",
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "packageManager": "yarn@4.10.3",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "chokidar": "^5.0.0",
    "zod": "^4"
  },
  "resolutions": {
    "minimatch": "^10.2.3",
    "tar": "^7.5.10",
    "@microsoft/api-extractor": "^7.58.7",
    "vite": "^7.3.1"
  }
}
