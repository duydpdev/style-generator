{
  // `yarn typecheck:dist`, ESM half. The declarations are checked with library
  // checking on (`skipLibCheck: false`) under `module: ESNext` + `Bundler`
  // resolution. The `dist/*.d.cts` twins are included as self-contained
  // declarations; their CommonJS resolution (`require` condition, `vite`
  // resolved as ESM) is checked by `tsconfig.dts-check.cjs.json`, and the
  // `exports` conditions by `yarn check:types-pack`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["dist/*.d.ts", "dist/*.d.cts", "scripts/dist-types.assert.ts"]
}
