{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "breakpoints": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
      },
      "description": "Not checked by this JSON Schema: `generate`, `style-gen doctor` and the bundler plugins also require each entry to name a screen: a key of `screens` or one of the default screens."
    },
    "screens": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\d+(\\.\\d+)?(px|rem|em)$"
      },
      "description": "Not checked by this JSON Schema: `generate`, `style-gen doctor` and the bundler plugins also require every screen, merged with the default screens, to use one unit."
    },
    "enableResponsive": {
      "type": "boolean"
    },
    "typography": {
      "type": "object",
      "properties": {
        "cssVarDriven": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "spacing": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          },
          "additionalProperties": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^-{0,2}[a-z][a-z0-9-]*$"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colors": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "prefixes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "bg",
                      "text",
                      "border",
                      "ring",
                      "outline",
                      "divide",
                      "placeholder"
                    ]
                  }
                },
                "keys": {
                  "type": "string",
                  "enum": [
                    "aliased",
                    "all"
                  ]
                },
                "opacities": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      {
                        "type": "object",
                        "properties": {
                          "steps": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 100
                            },
                            "uniqueItems": true
                          },
                          "prefixes": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "bg",
                                "text",
                                "border",
                                "ring",
                                "outline",
                                "divide",
                                "placeholder"
                              ]
                            }
                          },
                          "keys": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "steps"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "typography": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "keys": {
                  "type": "string",
                  "enum": [
                    "all"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "shadows": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "prefixes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "shadow"
                    ]
                  }
                },
                "keys": {
                  "type": "string",
                  "enum": [
                    "aliased",
                    "all"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "backdropBlurs": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "prefixes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "backdrop-blur"
                    ]
                  }
                },
                "keys": {
                  "type": "string",
                  "enum": [
                    "aliased",
                    "all"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "borderRadius": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "prefixes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "rounded",
                      "rounded-t",
                      "rounded-r",
                      "rounded-b",
                      "rounded-l"
                    ]
                  }
                },
                "keys": {
                  "type": "string",
                  "enum": [
                    "aliased",
                    "all"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "fontFamily": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "prefixes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "font"
                    ]
                  }
                },
                "keys": {
                  "type": "string",
                  "enum": [
                    "aliased",
                    "all"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "borderWidth": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "prefixes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "border",
                      "border-x",
                      "border-y",
                      "border-t",
                      "border-r",
                      "border-b",
                      "border-l",
                      "border-s",
                      "border-e",
                      "divide-x",
                      "divide-y"
                    ]
                  }
                },
                "keys": {
                  "type": "string",
                  "enum": [
                    "aliased",
                    "all"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "motionDuration": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "keys": {
                  "type": "string",
                  "enum": [
                    "all"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "motionEasing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "keys": {
                  "type": "string",
                  "enum": [
                    "all"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "controlHeight": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "keys": {
                  "type": "string",
                  "enum": [
                    "all"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "iconSize": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "keys": {
                  "type": "string",
                  "enum": [
                    "all"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "opacity": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "keys": {
                  "type": "string",
                  "enum": [
                    "all"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "zIndex": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "keys": {
                  "type": "string",
                  "enum": [
                    "all"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "resetTailwindDefaults": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "colors",
          "radius",
          "shadow"
        ]
      }
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "tokensOutput": {
      "type": "string",
      "minLength": 1
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
