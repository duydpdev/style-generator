# Branch-name rule: scripts/check-branch-name.sh (pr-title.yml runs it in CI).
# Git writes one "<local ref> <local sha> <remote ref> <remote sha>" line per
# pushed ref on stdin. Not checked: deletions (local sha all zeros), tags,
# main and develop. Skip once with HUSKY=0.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac
  case "$remote_ref" in
    refs/heads/main | refs/heads/develop) ;;
    refs/heads/*) sh scripts/check-branch-name.sh "${remote_ref#refs/heads/}" || exit 1 ;;
  esac
done
