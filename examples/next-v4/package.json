{
  "name": "next-v4-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "generate": "node ../../dist/cli/index.mjs generate --theme src/theme/theme.json --out src/theme/theme.css",
    "storybook": "yarn generate && storybook dev -p 6008 --no-open --disable-telemetry",
    "storybook:build": "yarn generate && storybook build --disable-telemetry",
    "test:stories": "yarn generate && vitest run --project 'storybook*'"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "next": "^16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@duydpdev/style-generator": "link:../..",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@storybook/react": "10.6.5",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.63.0",
    "storybook": "10.6.5",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.5",
    "vitest": "4.1.11"
  }
}
